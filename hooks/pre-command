#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ -z "$(plugin_read_config JOB_CTEST_COST_DATA_RESTORE_STAGING_PATH)" ]]; then
  exit 0
fi

# Scheduling history is optional; storage failures must not prevent the command.
"${VENV_BIN}/python" "${PLUGIN_DIR}/lib/ctest_cost_data.py" || \
  echo "WARNING: CTest cost restoration failed; continuing without scheduling history" >&2
