#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ "$(plugin_read_config DEBUG false)" =~ ^(true|on|1)$ ]]; then
  set -x
fi

# Pre-flight: the agent image names the interpreter, and it must run.
if [[ -z "${PYTHON3_CMD}" ]] || ! "${PYTHON3_CMD}" -c "" 2>/dev/null; then
  echo "+++ :rotating_light: qdb-test-report plugin needs the Python that QDB_CICD_AGENT_PLUGIN_PYTHON names"
  echo "QDB_CICD_AGENT_PLUGIN_PYTHON is '${QDB_CICD_AGENT_PLUGIN_PYTHON:-}' on this agent."
  echo "The agent images set it; an agent without it runs an image from before 2026-11-19."
  exit 1
fi

REQUIREMENTS="${PLUGIN_DIR}/lib/requirements.txt"

if [[ -d "${VENV_DIR}" ]]; then
  plugin_trace_command setup.remove_venv rm -rf "${VENV_DIR}"
fi

PIP_QUIET_ARGS=(--quiet --quiet)
case "$(plugin_read_config LOG_LEVEL error)" in
  debug|DEBUG|info|INFO)
    echo "~~~ :python: Setting up qdb-test-report plugin"
    PIP_QUIET_ARGS=(--quiet)
    ;;
  warning|WARNING)
    PIP_QUIET_ARGS=(--quiet)
    ;;
esac
plugin_trace_command setup.venv "${PYTHON3_CMD}" -m venv --upgrade-deps "${VENV_DIR}"
plugin_trace_command setup.dependencies "${VENV_BIN}/python" -m pip install "${PIP_QUIET_ARGS[@]}" \
  --disable-pip-version-check \
  --retries 3 \
  -r "${REQUIREMENTS}"
