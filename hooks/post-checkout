#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ "$(plugin_read_config DEBUG false)" =~ ^(true|on|1)$ ]]; then
  set -x
fi

# Pre-flight: verify Python 3 is available on the host agent.
if [[ -z "${PYTHON3_CMD}" ]]; then
  echo "+++ :rotating_light: qdb-test-report plugin requires Python 3.7 or newer on the host agent"
  echo "Install Python 3 on this agent or add it to the AMI via Packer."
  exit 1
fi

REQUIREMENTS="${PLUGIN_DIR}/lib/requirements.txt"

if [[ -d "${VENV_DIR}" ]]; then
  rm -rf "${VENV_DIR}"
fi

echo "~~~ :python: Setting up qdb-test-report plugin"
"${PYTHON3_CMD}" -m venv "${VENV_DIR}"
"${VENV_BIN}/python" -m pip install --quiet --retries 3 --upgrade pip
"${VENV_BIN}/python" -m pip install --quiet \
  --retries 3 \
  -r "${REQUIREMENTS}"
