{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuasarDB test execution manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "execution_id",
    "name",
    "junit",
    "status",
    "processes",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "junit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "aborted"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "error": {
      "type": "string"
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "pid"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "pid_namespace": {
            "enum": [
              "native",
              "shell"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "failed",
              "aborted"
            ]
          }
        }
      },
      "then": {
        "required": [
          "exit_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    }
  ]
}
